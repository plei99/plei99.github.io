---
import { LINKS } from "../lib/constants";

interface Props {
  title: string;
  description: string;
  page?: "travel" | "blog";
  slug?: string | undefined;
  pubDate?: string;
}

const { title, description, page, pubDate } = Astro.props;
const image =
  page === "travel"
    ? `${Astro.url.origin}/globe_preview.webp"`
    : `${Astro.url.origin}/og-image.png`;

const schema =
  page !== "blog"
    ? {
        "@context": "http://schema.org",
        "@type": "Person",
        name: "Patrick",
        url: Astro.url.origin,
        sameAs: [LINKS.arxiv, LINKS.github],
        image: `${Astro.url.origin}/og-image.png`,
        jobTitle: "Visiting Assistant Professor",
        worksFor: {
          "@type": "Organization",
          name: "Boston College",
          address: {
            "@type": "PostalAddress",
            addressLocality: "USA",
            addressCountry: "US",
          },
        },
        nationality: {
          "@type": "Country",
          name: "United States",
        },
      }
    : {
        "@context": "http://schema.org",
        "@type": "BlogPosting",
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": Astro.url.href,
        },
        headline: title || title,
        description: description || title,
        image: `${Astro.url.origin}/og-image.png`, //TODO: dynamic
        author: {
          "@type": "Person",
          name: "Patrick",
          url: Astro.url.origin,
          sameAs: [LINKS.notes, LINKS.github],
        },
        publisher: {
          "@type": "Organization",
          name: "Patrick",
          logo: {
            "@type": "ImageObject",
            url: `${Astro.url.origin}/og-image.png`,
          },
        },
        datePublished: pubDate || new Date().toISOString(),
        dateModified: pubDate || new Date().toISOString(),
      };
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <meta content={Astro.generator} name="generator" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content="index, follow" name="robots" />
    <!-- Basic OG tags for sharing your website's content on platforms like Facebook and LinkedIn -->
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="website" property="og:type" />
    <meta content={Astro.url.origin} property="og:url" />
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      property="og:image"
    />
    <!-- Basic Twitter Card tags -->
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      name="twitter:image"
    />
    <!-- Katex -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.15.2/dist/katex.min.css"
      integrity="sha384-MlJdn/WNKDGXveldHDdyRP1R4CTHr3FeuDNfhsLPYrq2t0UBkUdK2jyTnXPEK1NQ"
      crossorigin="anonymous"
    />

    <link href="https://cdn.fontshare.com" rel="preconnect" />
    <link href={Astro.url.href} rel="canonical" />
    <script
      is:inline
      set:html={JSON.stringify(schema)}
      type="application/ld+json"
    />
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme === "light" || storedTheme === "dark") {
          document.documentElement.setAttribute("data-theme", storedTheme);
        }
      })();
    </script>
  </head>
  <body class="md:h-screen flex flex-col justify-center items-center">
    <button
      id="theme-toggle"
      class="theme-button theme-border-strong theme-toggle border-1 border-solid rounded-full px-3 py-2 text-xs font-semibold uppercase tracking-wide fixed top-4 right-4 z-40"
      type="button"
      aria-pressed="false"
      aria-label="Toggle theme"
      title="Toggle theme"
    >
      <span id="theme-toggle-label" aria-hidden="true">☾</span>
    </button>
    <slot name="loader" />
    <slot />
    <script is:inline>
      (() => {
        const toggleButton = document.getElementById("theme-toggle");
        const toggleLabel = document.getElementById("theme-toggle-label");
        if (!toggleButton || !toggleLabel) return;

        const applyTheme = (theme) => {
          document.documentElement.setAttribute("data-theme", theme);
          localStorage.setItem("theme", theme);
          const isDark = theme === "dark";
          toggleButton.setAttribute("aria-pressed", String(isDark));
          toggleLabel.textContent = isDark ? "☀︎" : "☾";
        };

        const currentTheme =
          document.documentElement.getAttribute("data-theme") || "light";
        applyTheme(currentTheme);

        toggleButton.addEventListener("click", () => {
          const nextTheme =
            document.documentElement.getAttribute("data-theme") === "dark"
              ? "light"
              : "dark";
          applyTheme(nextTheme);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --color-bg: #f6f6f5;
    --color-surface: #ffffff;
    --color-text: #121212;
    --color-text-muted: #6b6b6b;
    --color-border: #e5e5e5;
    --color-border-strong: #d4d4d4;
    --color-btn-bg: #f5f5f5;
    --color-btn-bg-hover: #e9e9e9;
    --color-btn-text: #111111;
    --color-tooltip-bg: #111111;
    --color-tooltip-text: #f5f5f5;
    --color-code-bg: #f1f1f1;
    --color-code-text: #b4232c;
    --color-blockquote-border: #d4d4d4;
    --color-table-border: #e0e0e0;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --color-bg: #111111;
    --color-surface: #171717;
    --color-text: #f5f5f5;
    --color-text-muted: #a3a3a3;
    --color-border: #262626;
    --color-border-strong: #404040;
    --color-btn-bg: #111111;
    --color-btn-bg-hover: #1f1f1f;
    --color-btn-text: #f5f5f5;
    --color-tooltip-bg: #000000;
    --color-tooltip-text: #ffffff;
    --color-code-bg: #1f1f1f;
    --color-code-text: #ff8fa3;
    --color-blockquote-border: #404040;
    --color-table-border: #2c2c2c;
  }

  @font-face {
    font-family: "CabinetGrotesk";
    src: url("/fonts/CabinetGrotesk-Variable.ttf") format("truetype-variations");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }
  @font-face {
    font-family: "Satoshi";
    src: url("/fonts/Satoshi-Variable.ttf") format("truetype-variations");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }

  body {
    margin: 0;
    font-family: "Satoshi", sans-serif;
    -webkit-font-smoothing: antialiased;
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  a {
    color: inherit;
  }

  .theme-bg {
    background-color: var(--color-bg);
  }

  .theme-surface {
    background-color: var(--color-surface);
  }

  .theme-text {
    color: var(--color-text);
  }

  .theme-muted {
    color: var(--color-text-muted);
  }

  .theme-border {
    border-color: var(--color-border);
  }

  .theme-border-strong {
    border-color: var(--color-border-strong);
  }

  .theme-button {
    background-color: var(--color-btn-bg);
    color: var(--color-btn-text);
  }

  .theme-button:hover {
    background-color: var(--color-btn-bg-hover);
  }

  .theme-toggle {
    backdrop-filter: blur(8px);
  }

  .theme-tooltip {
    background-color: var(--color-tooltip-bg);
    color: var(--color-tooltip-text);
  }

  .theme-tooltip::after {
    background-color: var(--color-tooltip-bg);
  }

  :root[data-theme="light"] .text-primary-300 {
    color: #b01f2a;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Cabinet Grotesk", sans-serif;
  }
  p {
    font-family: "Satoshi";
  }

  b {
    font-weight: 700 !important;
  }
</style>
