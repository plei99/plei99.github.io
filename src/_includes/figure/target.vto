{{# The target X, drawn as a slanted sheet. Inside it is the image f(C), which
    meets each of the three cycles at the image of a marked point. The classes
    of the cycles are the insertions, and the links hang off the points f(x_i):
    papers (labelled arXiv) at f(x1), now at f(x2), CV at f(x3).

    Each cycle is an arc touching f(C) at its apex, so a vertical leader from
    the point runs up or down the open wedge between the two curves. #}}
<path class="fig-ink fig-draw" pathLength="1" d="M 658 110 L 950 110 L 918.5 320 L 626.5 320 Z"/>
<g class="fig-image fig-draw">
  <path pathLength="1" d="M 708 201 C 708 178, 728 160, 750 160 C 770 160, 776 176, 793 176 C 810 176, 815 157, 836 157 C 858 157, 873 176, 873 199 C 873 235, 845 282, 814 282 C 796 282, 792 256, 775 256 C 760 256, 752 270, 736 270 C 718 270, 708 228, 708 201 Z"/>
  <path pathLength="1" d="M 728 209 Q 748 229 768 209"/>
  <path pathLength="1" d="M 735 215 Q 748 203 761 215"/>
  <path pathLength="1" d="M 818 207 Q 838 227 858 207"/>
  <path pathLength="1" d="M 825 213 Q 838 201 851 213"/>
</g>
<g class="fig-math" aria-hidden="true">
  <text class="fig-math--lg" x="946" y="326" text-anchor="middle">X</text>
  <text class="fig-math--sm" x="793" y="147" text-anchor="middle">f(C)</text>
  <text class="fig-math--sm" x="697" y="207" text-anchor="end">f(x<tspan class="fig-sub" dy="4">1</tspan><tspan dy="-4">)</tspan></text>
  <text class="fig-math--sm" x="884" y="205">f(x<tspan class="fig-sub" dy="4">2</tspan><tspan dy="-4">)</tspan></text>
  <text class="fig-math--sm" x="822" y="312">f(x<tspan class="fig-sub" dy="4">3</tspan><tspan dy="-4">)</tspan></text>
  <text x="664" y="276">α<tspan class="fig-sub" dy="5">1</tspan></text>
  <text x="897" y="266">α<tspan class="fig-sub" dy="5">2</tspan></text>
  <text x="746" y="306">α<tspan class="fig-sub" dy="5">3</tspan></text>
</g>

<a class="fig-link" href="{{ site.pages.papers.href[lang] }}"{{ if section === "papers" }} aria-current="page"{{ /if }} data-id="papers">
  <path class="fig-hit" d="M 708 60 L 708 201 M 692 252 Q 724 201 692 150"/>
  <path class="fig-leader" d="M 708 84 L 708 193"/>
  <path class="fig-cycle" d="M 692 252 Q 724 201 692 150"/>
  <circle class="fig-pt" cx="708" cy="201" r="4.5"/>
  <text class="fig-word" x="708" y="72">{{ site.pages.papers.label[lang] }}</text>
</a>
<a class="fig-link" href="{{ site.pages.now.href[lang] }}"{{ if section === "now" }} aria-current="page"{{ /if }} data-id="now">
  <path class="fig-hit" d="M 873 60 L 873 199 M 890 148 Q 856 199 890 250"/>
  <path class="fig-leader" d="M 873 84 L 873 191"/>
  <path class="fig-cycle" d="M 890 148 Q 856 199 890 250"/>
  <circle class="fig-pt" cx="873" cy="199" r="4.5"/>
  <text class="fig-word" x="873" y="72">{{ site.pages.now.label[lang] }}</text>
</a>
<a class="fig-link" href="{{ site.pages.cv.href[lang] }}" rel="noopener" target="_blank" data-id="cv">
