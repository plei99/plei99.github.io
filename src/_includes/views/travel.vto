<header class="panel-head">
  <h1 id="panel-title">{{ travel[lang].title }}</h1>
</header>

<section class="atlas" aria-label="{{ ui[lang].travel }}">
  <div class="atlas-stage">
    <div id="globe-container" role="group" aria-label="{{ travel[lang].globe_label }}"
      data-fallback-label="{{ travel[lang].flat }}"
      data-visited="{{ travel.places.map(place => place.feature).join("|") }}">
      <img class="atlas-fallback" src="/images/travel-globe.svg" alt="{{ travel[lang].globe_label }}" width="800" height="800">
    </div>
    <div class="atlas-controls" aria-label="{{ travel[lang].controls }}">
      <button type="button" id="globe-zoom-in" aria-label="{{ travel[lang].zoom_in }}" title="{{ travel[lang].zoom_in }}" disabled>+</button>
      <button type="button" id="globe-zoom-out" aria-label="{{ travel[lang].zoom_out }}" title="{{ travel[lang].zoom_out }}" disabled>−</button>
      <button type="button" id="globe-reset" aria-label="{{ travel[lang].reset }}" title="{{ travel[lang].reset }}" disabled>↺</button>
      <button id="globe-motion-toggle" class="globe-motion-toggle" type="button" aria-pressed="false"
        aria-label="{{ travel[lang].play }}" title="{{ travel[lang].play }}"
        data-start-label="{{ travel[lang].play }}" data-pause-label="{{ travel[lang].pause }}" disabled>
        <span class="atlas-motion-icon" aria-hidden="true"></span>
      </button>
    </div>
    <span id="globe-keyboard-help" class="visually-hidden">{{ travel[lang].keyboard }}</span>
    <span id="globe-status" class="visually-hidden" role="status"></span>
  </div>
</section>

<script type="module" src="/js/globe.js"></script>
