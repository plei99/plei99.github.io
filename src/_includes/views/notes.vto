<div class="wrap">
  <header class="page-head">
    <h1 class="page-title">
      <span class="marker marker--lilac" aria-hidden="true"></span>
      {{ ui[lang].notes }}
    </h1>
    <p class="page-lede">{{ ui[lang].notes_lede }}</p>
  </header>

  {{ include "views/bow.vto" }}

  <section class="section section--tight">
    <ul class="rows">
      {{ for note of notes }}
      <li class="row row--notes">
        <div class="row-date"><span>{{ note.date }}</span></div>
        <div>
          <h2 class="row-title"><a href="{{ note.url }}">{{ note.name }}</a></h2>
          <p class="row-body">{{ note.description.trim() }}</p>
          {{ if note.zh_translations }}
          <div class="row-links">
            {{ for t of note.zh_translations }}
            <a href="{{ t.url }}">{{ ui[lang].zh_translation }} · {{ t.translator }}</a>
            {{ /for }}
          </div>
          {{ /if }}
        </div>
        <div class="row-meta"><span>{{ note.place }}</span></div>
      </li>
      {{ /for }}
    </ul>
  </section>
</div>
