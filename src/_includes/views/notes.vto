<header class="panel-head">
  <h1 id="panel-title">{{ ui[lang].notes }}</h1>
  <p class="lede">{{ ui[lang].notes_lede }}</p>
</header>

<ul class="entries">
  {{ for note of notes }}
  {{ set n = lang === "zh" && note.zh ? { ...note, ...note.zh } : note }}
  <li class="entry">
    <p class="entry-when">{{ n.date }}</p>
    <div>
      <h2 class="entry-title"><a href="{{ note.url }}">{{ n.name }}</a></h2>
      <p class="entry-where">{{ n.place }}</p>
      <p class="entry-body">{{ n.description.trim() }}</p>
      {{ if note.zh_translations }}
      <p class="entry-extra">
        {{ ui[lang].zh_translation }}{{ lang === "zh" ? "：" : ":" }}
        {{ for i, t of note.zh_translations }}{{ if i }}{{ lang === "zh" ? "、" : ", " }}{{ /if }}<a href="{{ t.url }}">{{ t.translator }}</a>{{ /for }}
      </p>
      {{ /if }}
    </div>
  </li>
  {{ /for }}
</ul>
