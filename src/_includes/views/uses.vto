<header class="panel-head">
  <h1 id="panel-title">{{ ui[lang].uses }}</h1>
  <p class="lede">{{ ui[lang].uses_lede }}</p>
</header>

{{ for category of uses }}
<section class="uses-group" aria-labelledby="uses-{{ category.id }}-heading">
  <h2 id="uses-{{ category.id }}-heading">{{ category.title[lang] }}</h2>

  {{ if category.body }}
  <div class="prose">
    {{ category.body[lang] |> md }}
  </div>
  {{ /if }}

  <ul class="entries">
    {{ for item of category.items }}
    <li class="entry">
      <p class="entry-when">{{ item.kind[lang] }}</p>
      <div>
        <h3 class="entry-title">{{ if item.url }}<a href="{{ item.url }}">{{ item.name }}</a>{{ else }}{{ item.name }}{{ /if }}</h3>
        <p class="entry-body">{{ item.note[lang] |> md(true) }}</p>
      </div>
    </li>
    {{ /for }}
  </ul>
</section>
{{ /for }}

<p class="aside"><a href="https://uses.tech/">{{ ui[lang].uses_what }}</a></p>
