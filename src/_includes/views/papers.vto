<header class="panel-head">
  <h1 id="panel-title">{{ ui[lang].papers }}</h1>
  <p class="lede">{{ ui[lang].papers_lede }} <a href="{{ site.contact.arxiv }}">{{ ui[lang].arxiv_author }}</a></p>
</header>

{{# Numbered like a bibliography, oldest paper first in the numbering so the
    numbers stay stable as new papers are added at the top. #}}
<ol class="refs" reversed>
  {{ for index, paper of papers }}
  <li>
    <span class="ref-n" aria-hidden="true">[{{ papers.length - index }}]</span>
    <p class="ref-title">
      <a href="https://arxiv.org/abs/{{ paper.arxiv }}">{{ paper.title.trim().replace(/\^(\d+)/g, "<sup>$1</sup>") }}</a>
    </p>
    {{ if lang === "zh" && paper.title_zh }}<p class="ref-gloss">{{ paper.title_zh }}</p>{{ /if }}
    <p class="ref-meta">
      {{ ui[lang].author_short }}, {{ paper.date |> date("yyyy") }}.
      <a href="https://arxiv.org/abs/{{ paper.arxiv }}">arXiv:{{ paper.arxiv }}</a>
      [{{ paper.categories.join(", ") }}]{{ if paper.pages }}, {{ paper.pages }} {{ ui[lang].pages }}{{ /if }}
      (<a href="https://arxiv.org/pdf/{{ paper.arxiv }}">{{ ui[lang].pdf }}</a>)
    </p>
  </li>
  {{ /for }}
</ol>
