<header class="panel-head">
  <h1 id="panel-title">{{ ui[lang].seminars }}</h1>
  <p class="lede">{{ ui[lang].seminars_lede }}</p>
</header>

<ul class="entries">
  {{ for seminar of search.pages("type=seminar", "pubDate=desc") }}
  <li class="entry">
    <p class="entry-when">{{ seminar.pubDate |> date(lang === "zh" ? "yyyy 年 M 月" : "MMM yyyy") }}</p>
    <div>
      <h2 class="entry-title"><a href="{{ seminar.url }}">{{ lang === "zh" && seminar.title_zh ? seminar.title_zh : seminar.title }}</a></h2>
      <p class="entry-body">{{ lang === "zh" && seminar.description_zh ? seminar.description_zh : seminar.description }}</p>
    </div>
  </li>
  {{ /for }}
</ul>
