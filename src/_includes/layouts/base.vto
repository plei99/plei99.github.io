<!DOCTYPE html>
<html lang="{{ lang === "zh" ? "zh-CN" : "en" }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{{ if title !== site.name }} · {{ site.name }}{{ /if }}</title>
<meta name="description" content="{{ description || site.description[lang] }}">
<link rel="canonical" href="{{ url |> url(true) }}">
{{ if altUrl }}
<link rel="alternate" hreflang="{{ lang === "zh" ? "en" : "zh-Hans" }}" href="{{ altUrl |> url(true) }}">
<link rel="alternate" hreflang="{{ lang === "zh" ? "zh-Hans" : "en" }}" href="{{ url |> url(true) }}">
{{ /if }}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description || site.description[lang] }}">
<meta property="og:url" content="{{ url |> url(true) }}">
<meta property="og:locale" content="{{ lang === "zh" ? "zh_CN" : "en_US" }}">
<meta name="twitter:card" content="summary">
<link rel="icon" href="/favicon.ico" sizes="any">
<meta name="color-scheme" content="light dark">
<script>
  // Apply a saved theme before first paint. With nothing saved, the
  // stylesheet follows the system setting on its own.
  try {
    var theme = localStorage.getItem("theme");
    if (theme === "dark" || theme === "light") document.documentElement.dataset.theme = theme;
  } catch (_) {}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,600;1,400;1,600&display=swap">
<link rel="stylesheet" href="/styles.css">
<script type="module" src="/js/panel.js"></script>
<script type="module" src="/js/theme.js"></script>
</head>
{{ set homeUrl = lang === "zh" ? "/zh/" : "/en/" }}
{{ set isHome = section === "home" }}
<body data-home="{{ homeUrl }}" data-home-title="{{ site.name }}"{{ if isHome }} class="is-home"{{ /if }}>
<a class="skip-link" href="{{ isHome ? "#figure" : "#panel" }}">{{ ui[lang].skip_to_content }}</a>

<div class="page">
  <header class="masthead">
    <div>
      {{ if isHome }}
      <h1 class="name">{{ site.name }}</h1>
      {{ else }}
      <p class="name"><a href="{{ homeUrl }}">{{ site.name }}</a></p>
      {{ /if }}
      <p class="tagline">{{ home.tagline[lang] }}</p>
    </div>
    <div class="controls">
    <button class="theme-toggle" type="button" hidden aria-label="{{ ui[lang].theme_toggle }}"
      data-dark-label="{{ ui[lang].theme_dark }}" data-light-label="{{ ui[lang].theme_light }}"></button>
    {{# Like the theme button, the language link names what it switches to. #}}
    {{ if lang === "zh" }}
    <a class="langswitch" lang="en" hreflang="en" data-no-panel href="{{ altUrl || switchUrl || "/en/" }}">English</a>
    {{ else }}
    <a class="langswitch" lang="zh-CN" hreflang="zh-Hans" data-no-panel href="{{ altUrl || switchUrl || "/zh/" }}">中文</a>
    {{ /if }}
    </div>
  </header>

  <main id="figure" tabindex="-1">
    {{ include "figure/figure.vto" }}
  </main>

  <footer class="colophon">
    <p>
      <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      <a href="{{ site.contact.github }}">GitHub</a>
    </p>
    <p>
      {{ site.footer.copyright }}
      {{ for link of site.footer.links }}
      <a href="{{ link.href }}">{{ link.label }}</a>
      {{ /for }}
    </p>
  </footer>
</div>

{{# Every page other than the home page is this panel, already open in the
    static HTML. panel.js upgrades it to a modal dialog and swaps its content
    when a label in the figure is followed. #}}
<dialog id="panel" class="panel" aria-labelledby="panel-title"{{ if !isHome }} open{{ /if }}>
  <a class="panel-close" href="{{ homeUrl }}" aria-label="{{ ui[lang].close }}" title="{{ ui[lang].close }}"><span aria-hidden="true">×</span></a>
  <article id="panel-content" tabindex="-1" data-section="{{ section }}" data-title="{{ title }}{{ if title !== site.name }} · {{ site.name }}{{ /if }}">
    {{ if !isHome }}{{ content }}{{ /if }}
  </article>
</dialog>
</body>
</html>
