<!DOCTYPE html>
<html lang="{{ lang === "zh" ? "zh-CN" : "en" }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{{ if title !== site.name }} · {{ site.name }}{{ /if }}</title>
<meta name="description" content="{{ description || site.description[lang] }}">
<link rel="canonical" href="{{ url |> url(true) }}">
{{ if altUrl }}
<link rel="alternate" hreflang="{{ lang === "zh" ? "en" : "zh-Hans" }}" href="{{ altUrl |> url(true) }}">
<link rel="alternate" hreflang="{{ lang === "zh" ? "zh-Hans" : "en" }}" href="{{ url |> url(true) }}">
{{ /if }}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description || site.description[lang] }}">
<meta property="og:url" content="{{ url |> url(true) }}">
<meta property="og:locale" content="{{ lang === "zh" ? "zh_CN" : "en_US" }}">
<meta name="twitter:card" content="summary">
<link rel="icon" href="/favicon.ico" sizes="any">
<meta name="color-scheme" content="light dark">
{{ if detectLanguage }}
<script>
  // First visit from a browser set to Chinese: go to the Chinese site. Skipped
  // once the visitor has used the language link (panel.js records that), and
  // when arriving from another page of this site.
  try {
    var here = document.referrer.indexOf(location.origin) === 0;
    if (!here && !localStorage.getItem("lang") &&
        (navigator.language || "").toLowerCase().indexOf("zh") === 0) {
      location.replace("/zh/");
    }
  } catch (_) {}
</script>
{{ /if }}
<script>
  // Apply a saved theme before first paint. With nothing saved, the
  // stylesheet uses Modus and follows the system's light or dark setting.
  try {
    var theme = localStorage.getItem("theme");
    if (theme) document.documentElement.dataset.theme = theme;
  } catch (_) {}
</script>
<link rel="preload" href="/fonts/tex-gyre-pagella-regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css?v={{ rev }}">
<link rel="stylesheet" href="/themes.css?v={{ rev }}">
<link rel="stylesheet" href="/styles.css?v={{ rev }}">
<script type="module" src="/js/panel.js?v={{ rev }}"></script>
<script type="module" src="/js/theme.js?v={{ rev }}"></script>
</head>
{{ set homeUrl = lang === "zh" ? "/zh/" : "/" }}
{{ set isHome = section === "home" }}
<body data-home="{{ homeUrl }}" data-home-title="{{ site.name }}"{{ if isHome }} class="is-home"{{ /if }}>
<a class="skip-link" href="{{ isHome ? "#figure" : "#panel" }}">{{ ui[lang].skip_to_content }}</a>

<div class="page">
  <header class="masthead">
    <div>
      {{ if isHome }}
      <h1 class="name">{{ site.name }}</h1>
      {{ else }}
      <p class="name"><a href="{{ homeUrl }}">{{ site.name }}</a></p>
      {{ /if }}
      <p class="tagline">{{ home.tagline[lang] }}</p>
    </div>
    <div class="controls">
    <label class="scheme" hidden>
      <span class="visually-hidden">{{ ui[lang].theme }}</span>
      {{ set allThemes = themes.flatMap((family) => family.themes) }}
      <select data-default-light="{{ allThemes.find((t) => !t.dark).id }}" data-default-dark="{{ allThemes.find((t) => t.dark).id }}">
        {{ for family of themes }}
        {{ if family.themes.length > 1 }}
        <optgroup label="{{ family.family }}">
          {{ for theme of family.themes }}
          <option value="{{ theme.id }}">{{ theme.name }}</option>
          {{ /for }}
        </optgroup>
        {{ else }}
        <option value="{{ family.themes[0].id }}">{{ family.themes[0].name }}</option>
        {{ /if }}
        {{ /for }}
      </select>
    </label>
    {{# The language link names the language it switches to. #}}
    {{ if lang === "zh" }}
    <a class="langswitch" lang="en" hreflang="en" data-no-panel href="{{ altUrl || switchUrl || "/" }}">English</a>
    {{ else }}
    <a class="langswitch" lang="zh-CN" hreflang="zh-Hans" data-no-panel href="{{ altUrl || switchUrl || "/zh/" }}">中文</a>
    {{ /if }}
    </div>
  </header>

  <main id="figure" tabindex="-1">
    {{ include "figure/figure.vto" }}
  </main>

  <footer class="colophon">
    <p>
      <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      <a href="{{ site.contact.github }}">GitHub</a>
    </p>
    <p>
      {{ site.footer.copyright }}
      {{ for link of site.footer.links }}
      <a href="{{ link.href }}">{{ link.label }}</a>
      {{ /for }}
    </p>
  </footer>
</div>

{{# Every page other than the home page is this panel, already open in the
    static HTML. panel.js upgrades it to a modal dialog and swaps its content
    when a label in the figure is followed. #}}
<dialog id="panel" class="panel" aria-labelledby="panel-title"{{ if !isHome }} open{{ /if }}>
  <a class="panel-close" href="{{ homeUrl }}" aria-label="{{ ui[lang].close }}" title="{{ ui[lang].close }}"><span aria-hidden="true">×</span></a>
  <article id="panel-content" tabindex="-1" data-section="{{ section }}" data-title="{{ title }}{{ if title !== site.name }} · {{ site.name }}{{ /if }}">
    {{ if !isHome }}{{ content }}{{ /if }}
  </article>
</dialog>
</body>
</html>
