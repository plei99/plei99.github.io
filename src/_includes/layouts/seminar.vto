---
layout: layouts/base.vto
---
<header class="panel-head">
  <p class="panel-back"><a href="/seminars/">{{ ui[lang].back_to_seminars }}</a></p>
  <h1 id="panel-title">{{ title }}</h1>
  <p class="lede">{{ pubDate |> date("MMMM yyyy") }}. {{ description }}</p>
</header>

<div class="prose prose--wide">
  {{ content }}
</div>
