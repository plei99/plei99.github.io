---
import { formatDate } from "../../lib/helpers";

interface Props {
  title: string;
  date: Date;
  id: string;
}

const { title, date, id } = Astro.props;
---

<li
  class="list-none w-full theme-text hover:opacity-70 ease-in-out transition-opacity border-dashed border-b-1 theme-border-strong my-2"
>
  <a
    class="text-sm md:text-base decoration-none flex justify-between"
    href={`/seminars/${id}`}
  >
    <p class="inline-block whitespace-nowrap">
      {title}
    </p>
    <time
      class="text-right tabular-nums"
      data-date={date.toISOString()}       datetime={date.toISOString()}
    >
      {formatDate(date)}
    </time>
  </a>
</li>
