---
import Card from "./Card/index.astro";
import { defaultLocale, getStrings, type Locale } from "../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = getStrings(locale);
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-6" title={t.about.title}>
  <div class="flex flex-col gap-2">
    <div class="text-sm font-light">
      <p>{t.about.leadIn}</p>
      <ul class="list-disc list-inside">
        <li>
          <a
            class="text-primary-300"
            href="https://www.umass.edu/mathematics-statistics/"
          >
            {t.about.umass.school}
          </a>
          {t.about.umass.afterSchool}
          <a class="text-primary-300" href="https://paulhacking.github.io/">
            {t.about.umass.advisor}
          </a>
          {t.about.umass.afterAdvisor}
          <a class="text-primary-300" href="https://www.cics.umass.edu/">
            {t.about.umass.major}
          </a>
          {t.about.umass.afterMajor}
        </li>
        <li>{t.about.meet}</li>
      </ul>
    </div>
    <div class="text-sm font-light">
      <p class="text-sm font-light">
        {t.about.research.beforeNotes}
        <a
          class="text-primary-300"
          href="https://github.com/plei99/notes/raw/master/misc/simons25/hg.pdf"
        >
          {t.about.research.notes}
        </a>
        {t.about.research.middle}
        <a
          class="text-primary-300"
          href="https://scgp.stonybrook.edu/archives/42649"
        >
          {t.about.research.scgp}
        </a>
        {t.about.research.afterScgp}
      </p>
    </div>
    <p class="text-sm font-light">
      {t.about.hobbies}
    </p>
  </div>
</Card>
