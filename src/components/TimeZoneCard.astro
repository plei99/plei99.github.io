---
import { getCurrentTimeInBoston, formatTimeForBoston } from "../lib/helpers";
import Card from "./Card/index.astro";
import { defaultLocale, getStrings, type Locale } from "../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = getStrings(locale);
---

<script>
  import { onCleanup, onMount } from "solid-js";
  import { formatTimeForBoston } from "../lib/helpers";

  let interval: ReturnType<typeof setInterval>;

  function updateClock() {
    const timeDisplay = document.getElementById("timeDisplay");
    const now = new Date();

    if (timeDisplay) {
      timeDisplay.textContent = formatTimeForBoston(now);
      timeDisplay.setAttribute("datetime", now.toISOString());
    }
  }

  onMount(() => {
    interval = setInterval(updateClock, 1000);
  });

  onCleanup(() => {
    clearInterval(interval);
  });
</script>

<Card
  colSpan="lg:col-span-2"
  rowSpan="md:row-span-2"
  title={t.timeZone.title}
>
  <time
    class="text-2xl xl:text-5xl xl:whitespace-nowrap w-50 xl:w-100 h-[calc(100%-28px)] font-serif flex justify-center items-center"     datetime=""     id="timeDisplay"
  >
    {formatTimeForBoston(getCurrentTimeInBoston())}
  </time>
</Card>
