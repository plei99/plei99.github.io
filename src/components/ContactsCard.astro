---
import Card from "./Card/index.astro";
import { LINKS } from "../lib/constants";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4">
  <div class="h-full">
    <header class="flex items-center">
      <h1 class="text-white text-xl font-bold">
        Contact me
      </h1>
    </header>
    <address class="flex flex-col mt-4">
      <h2 class="text-gray-500">Contact Details</h2>
      <p>patrick.lei@bc.edu</p>
      <p>United States</p>
    </address>
    <div class="flex flex-col mt-4 w-fit">
      <h2 class="text-gray-500">Links</h2>
      <ul>
        <li>
          <a href={LINKS.notes} target="_blank">Notes</a>
        </li>
        <li>
          <a href={LINKS.github} target="_blank">Github</a>
        </li>
        <li>
          <a href={LINKS.arxiv} target="_blank">Papers on arXiv</a>
        </li>
        <li>
          <a href={LINKS.cv} target="_blank">CV</a>
        </li>
      </ul>
    </div>
  </div>
</Card>
