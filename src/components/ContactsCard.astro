---
import Card from "./Card/index.astro";
import { LINKS } from "../lib/constants";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4">
  <div class="h-full">
    <header class="flex items-center">
      <h1 class="text-xl font-bold">
        Contact me
      </h1>
    </header>
    <address class="flex flex-col mt-4">
      <h2 class="theme-muted">Contact Details</h2>
      <p>patrick.lei@bc.edu</p>
      <p>Maloney Hall, Room 571</p>
      <p>140 Commonwealth Avenue</p>
      <p>Chestnut Hill, MA 02467</p>
    </address>
    <div class="flex flex-col mt-4 w-fit">
      <h2 class="theme-muted">Links</h2>
      <ul>
        <li class="list-none">
          <a href={LINKS.notes} target="_blank">Notes</a>
        </li>
        <li class="list-none">
          <a href={LINKS.ag} target="_blank">math.AG</a>
        </li>
        <li class="list-none">
          <a href={LINKS.seminar} target="_blank">AG Seminar</a>
        </li class="list-none">
        <li class="list-none">
          <a href={LINKS.cv} target="_blank">CV</a>
        </li>
      </ul>
    </div>
  </div>
</Card>
